# Cache content-hashed assets immutably (generated by vinext)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Browsers request /favicon.ico at the root whatever icon the page declares.
# The static-assets MIME table files .ico as image/vnd.microsoft.icon, so pin
# the type the favicon contract names.
/favicon.ico
  Content-Type: image/x-icon
